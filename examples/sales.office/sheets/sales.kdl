spreadsheet version="1" {
    workbook {
        name "売上分析"
    }

    sheet "売上" {
        cell "A1" value="日付"
        cell "B1" value="商品カテゴリ"
        cell "C1" value="売上金額（円）"
        cell "D1" value="数量"
        cell "E1" value="単価（円）"
        cell "F1" value="地域"
        cell "A2" value="2026-04-01"
        cell "B2" value="ノートPC"
        cell "C2" value=1250000
        cell "D2" value=10
        cell "E2" value=125000
        cell "F2" value="東京"
        cell "A3" value="2026-04-01"
        cell "B3" value="モニター"
        cell "C3" value=320000
        cell "D3" value=16
        cell "E3" value=20000
        cell "F3" value="大阪"
        cell "A4" value="2026-04-02"
        cell "B4" value="キーボード"
        cell "C4" value=86000
        cell "D4" value=20
        cell "E4" value=4300
        cell "F4" value="名古屋"
        cell "A5" value="2026-04-02"
        cell "B5" value="マウス"
        cell "C5" value=54000
        cell "D5" value=30
        cell "E5" value=1800
        cell "F5" value="福岡"
        cell "A6" value="2026-04-03"
        cell "B6" value="ノートPC"
        cell "C6" value=875000
        cell "D6" value=7
        cell "E6" value=125000
        cell "F6" value="札幌"
        cell "A7" value="合計"
        cell "C7" formula="SUM(C2:C6)"
        cell "D7" formula="SUM(D2:D6)"
    }
}
