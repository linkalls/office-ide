{
  "name": "office-ide",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/core/*"
  ],
  "scripts": {
    "dev": "bun --cwd apps/desktop dev",
    "build": "bun --cwd apps/desktop build",
    "codex:schema": "bun scripts/generate-codex-schema.ts",
    "codex:smoke": "bun scripts/smoke-codex-app-server.ts",
    "demo:record": "bun scripts/record-agent-demo.ts",
    "qa:complete": "bun run typecheck && bun test && bun run build && bun run demo:record",
    "test": "bun test",
    "typecheck": "bun --cwd apps/desktop typecheck",
    "tauri": "bun --cwd apps/desktop tauri"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "bun": "1.3.14",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.2"
  }
}
